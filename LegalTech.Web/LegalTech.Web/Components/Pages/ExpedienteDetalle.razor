    private async Task ConfirmarEliminarDocumento(DocumentoExpediente d)
    {
        var confirm = await DialogService.Confirm(
            $"¿Está seguro de eliminar permanentemente el documento '{d.NombreOriginal}' del expediente y del disco?",
            "Confirmar Eliminación",
            new ConfirmOptions { OkButtonText = "Sí, Eliminar", CancelButtonText = "Cancelar" });

        if (confirm == true)
        {
            var ok = await DocumentoService.EliminarDocumentoAsync(d.Id);
            if (ok)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Eliminado", "Documento eliminado correctamente.");
                await CargarExpediente();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo eliminar el documento.");
            }
        }
    }

    private string FormatTamano(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private string ObtenerIconoFormato(string extension)
    {
        return extension.ToLowerInvariant() switch
        {
            ".pdf" => "picture_as_pdf",
            ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" => "image",
            ".doc" or ".docx" => "article",
            ".xls" or ".xlsx" => "table_view",
            _ => "insert_drive_file"
        };
    }

    private string ObtenerClaseColorFormato(string extension)
    {
        return extension.ToLowerInvariant() switch
        {
            ".pdf" => "text-danger",
            ".jpg" or ".jpeg" or ".png" or ".webp" => "text-primary",
            ".doc" or ".docx" => "text-info",
            ".xls" or ".xlsx" => "text-success",
            _ => "text-secondary"
        };
    }

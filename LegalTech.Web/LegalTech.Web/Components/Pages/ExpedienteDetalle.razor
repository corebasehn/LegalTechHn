    private async Task CargarExpediente()
    {
        cargando = true;
        clientes = await ClienteService.GetClientesAsync();
        tiposSigno = await CatalogoService.GetTiposSignoAsync(soloActivos: true);
        estadosProcesales = await CatalogoService.GetEstadosProcesalesAsync(soloActivos: true);
        tiposActuaciones = await CatalogoService.GetTiposActuacionesAsync(soloActivos: true);
        viasPresentacion = await CatalogoService.GetViasPresentacionAsync(soloActivos: true);
        ubicacionesArchivo = await CatalogoService.GetUbicacionesArchivoAsync(soloActivos: true);

        expediente = await ExpedienteService.GetExpedienteDetalleAsync(Id);

        if (expediente != null)
        {
            // Inicializar publicación
            publicacionActual = expediente.Publicaciones.FirstOrDefault() ?? new PublicacionENAG
            {
                ExpedienteId = expediente.Id
            };

            // Inicializar certificado
            certificadoActual = expediente.Certificado ?? new CertificadoRegistro
            {
                ExpedienteId = expediente.Id,
                FechaConcesion = DateTime.UtcNow,
                FechaVencimientoDecenal = DateTime.UtcNow.AddYears(10),
                UbicacionArchivoId = ubicacionesArchivo.FirstOrDefault(u => u.Nombre.Contains("Bóveda"))?.Id ?? ubicacionesArchivo.FirstOrDefault()?.Id
            };

            // Inicializar plazos legales del expediente y evaluar semáforo procesal
            plazosExpediente = await PlazosService.ObtenerPlazosExpedienteAsync(Id);
            plazoMasUrgente = await PlazosService.ObtenerPlazoMasUrgenteAsync(Id);
            semaforosPlazos.Clear();
            foreach (var p in plazosExpediente)
            {
                int dias = await PlazosService.CalcularDiasHabilesRestantesAsync(p.FechaVencimientoFatal);
                semaforosPlazos[p.Id] = PlazosService.EvaluarSemaforo(dias, p.Cumplido);
            }
            await ActualizarProyeccionVencimiento();

            // Cargar controversias y litigios del expediente
            litigiosExpediente = await LitigioService.GetLitigiosPorExpedienteAsync(Id);

            // Cargar solvencia financiera P360 y facturación vinculada
            var solvencia = await FacturacionService.ConsultarSolvenciaExpedienteAsync(Id);
            esSolventeP360 = solvencia.EsSolvente;
            saldoPendienteExpediente = solvencia.SaldoPendienteTotal;
            facturasExpediente = await FacturacionService.GetFacturasPorExpedienteAsync(Id);

            // Cargar repositorio de documentos (MOD-06)
            documentosExpediente = await DocumentoService.GetDocumentosPorExpedienteAsync(Id);
            proveedorAlmacenamientoActivo = await ConfiguracionService.GetValorAsync("TipoAlmacenamiento", "LOCAL");
            FiltrarDocumentos();

            // Inicializar nueva actuación
            ResetNuevaActuacion();
        }

        cargando = false;
    }

    private void ResetNuevaActuacion()
    {
        nuevaActuacion = new ActuacionExpediente
        {
            ExpedienteId = Id,
            TipoActuacionId = tiposActuaciones.FirstOrDefault()?.Id ?? 1,
            FechaActuacion = DateTime.UtcNow,
            UsuarioResponsable = expediente?.AbogadoResponsable ?? "Abogado Asignado"
        };

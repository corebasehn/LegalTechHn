    private void FiltrarPorCategoria(string cat)
    {
        filtroCategoriaDoc = cat;
        FiltrarDocumentos();
    }

    private void FiltrarDocumentos()
    {
        if (filtroCategoriaDoc == "Todas")
        {
            documentosFiltrados = documentosExpediente.OrderByDescending(d => d.FechaSubida).ToList();
        }
        else
        {
            documentosFiltrados = documentosExpediente
                .Where(d => d.Categoria.Equals(filtroCategoriaDoc, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(d => d.FechaSubida)
                .ToList();
        }
    }

    private void AlSeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        if (archivoSeleccionado != null)
        {
            var ext = Path.GetExtension(archivoSeleccionado.Name).ToLowerInvariant();
            if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".webp")
            {
                tipoDocumentoNuevo = "Logotipo / Etiqueta del Signo";
                categoriaNueva = "Solicitud";
            }
            else if (ext == ".pdf")
            {
                if (archivoSeleccionado.Name.Contains("presentacion", StringComparison.OrdinalIgnoreCase) ||
                    archivoSeleccionado.Name.Contains("caratula", StringComparison.OrdinalIgnoreCase))
                {
                    tipoDocumentoNuevo = "Carátula Sellada DIGEPIH (Comprobante de Presentación)";
                    categoriaNueva = "Solicitud";
                }
                else if (archivoSeleccionado.Name.Contains("poder", StringComparison.OrdinalIgnoreCase))
                {
                    tipoDocumentoNuevo = "Poder de Representación Legal / Mandato";
                    categoriaNueva = "Poderes";
                }
                else if (archivoSeleccionado.Name.Contains("gaceta", StringComparison.OrdinalIgnoreCase) ||
                         archivoSeleccionado.Name.Contains("aviso", StringComparison.OrdinalIgnoreCase))
                {
                    tipoDocumentoNuevo = "Aviso 1 Publicado en La Gaceta (ENAG)";
                    categoriaNueva = "La Gaceta (ENAG)";
                }
                else if (archivoSeleccionado.Name.Contains("titulo", StringComparison.OrdinalIgnoreCase) ||
                         archivoSeleccionado.Name.Contains("certificado", StringComparison.OrdinalIgnoreCase))
                {
                    tipoDocumentoNuevo = "Certificado Oficial de Registro de Marca (Título)";
                    categoriaNueva = "Título y Concesión";
                }
            }
        }
    }

    private async Task SubirArchivoConfirmado()
    {
        if (expediente == null || archivoSeleccionado == null) return;

        try
        {
            subiendoArchivo = true;
            using var stream = archivoSeleccionado.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024); // 25 MB

            var doc = await DocumentoService.SubirYGuardarDocumentoAsync(
                expedienteId: expediente.Id,
                archivoStream: stream,
                nombreOriginal: archivoSeleccionado.Name,
                tipoMime: archivoSeleccionado.ContentType,
                tamanoBytes: archivoSeleccionado.Size,
                categoria: categoriaNueva,
                tipoDocumento: tipoDocumentoNuevo,
                observaciones: observacionesNuevoDoc,
                custodiaFisicaVerificada: custodiaFisicaNuevoDoc,
                ubicacionFisica: custodiaFisicaNuevoDoc ? (ubicacionFisicaNuevoDoc ?? "Archivo Central") : null,
                subidoPor: expediente.AbogadoResponsable ?? "Usuario Actual"
            );

            NotificationService.Notify(NotificationSeverity.Success, "Documento Archivado", $"Se ha archivado '{doc.NombreOriginal}' exitosamente.");

            archivoSeleccionado = null;
            observacionesNuevoDoc = null;
            custodiaFisicaNuevoDoc = false;
            ubicacionFisicaNuevoDoc = null;
            mostrandoFormSubida = false;

            await CargarExpediente();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al subir", ex.Message);
        }
        finally
        {
            subiendoArchivo = false;
        }
    }


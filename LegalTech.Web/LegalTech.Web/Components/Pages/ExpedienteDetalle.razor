    private async Task RegistrarPresentacionOficialFormal()
    {
        if (expediente == null) return;
        if (string.IsNullOrWhiteSpace(expediente.NumeroExpedienteDIGEPIH))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validación", "Debe ingresar el número oficial asignado por DIGEPIH.");
            return;
        }
        if (!expediente.FechaPresentacionOficial.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validación", "Debe seleccionar la fecha de presentación oficial (que fija la prioridad).");
            return;
        }

        await ExpedienteService.RegistrarPresentacionOficialAsync(
            expediente.Id,
            expediente.NumeroExpedienteDIGEPIH,
            expediente.FechaPresentacionOficial.Value,
            expediente.ViaPresentacionId ?? 1,
            expediente.AbogadoResponsable ?? "Abogado Asignado");

        NotificationService.Notify(NotificationSeverity.Success, "Presentación Oficial", "Solicitud formalmente presentada ante DIGEPIH. Se fijó la prioridad legal nacional y el expediente avanzó al estado 'Presentado ante DIGEPIH'.");
        await CargarExpediente();
    }

    private async Task RegistrarAvisoHoy(int numeroAviso)
    {
        if (publicacionActual == null || expediente == null) return;
        var hoy = DateTime.UtcNow;

        if (numeroAviso == 1)
        {
            publicacionActual.FechaPublicacionAviso1 = hoy;
            await ExpedienteService.RegistrarActuacionAsync(new ActuacionExpediente
            {
                ExpedienteId = expediente.Id,
                TipoActuacionId = 9, // Aviso Publicado
                Titulo = "Publicación del 1er Aviso en La Gaceta (ENAG)",
                Comentario = $"Primer aviso oficial publicado el {hoy:dd/MM/yyyy}. Comienza el intervalo de 15 días.",
                FechaActuacion = hoy,
                UsuarioResponsable = expediente.ParalegalAsignado ?? "Paralegal Encargado"
            }, 14); // En Publicación La Gaceta
        }
        else if (numeroAviso == 2)
        {
            publicacionActual.FechaPublicacionAviso2 = hoy;
            await ExpedienteService.RegistrarActuacionAsync(new ActuacionExpediente
            {
                ExpedienteId = expediente.Id,
                TipoActuacionId = 9,
                Titulo = "Publicación del 2do Aviso en La Gaceta (ENAG)",
                Comentario = $"Segundo aviso publicado el {hoy:dd/MM/yyyy}.",
                FechaActuacion = hoy,
                UsuarioResponsable = expediente.ParalegalAsignado ?? "Paralegal Encargado"
            });
        }
        else if (numeroAviso == 3)
        {
            publicacionActual.FechaPublicacionAviso3 = hoy;
            publicacionActual.FechaFinPeriodoOposicion = hoy.AddDays(42); // ~30 días hábiles
            await ExpedienteService.RegistrarActuacionAsync(new ActuacionExpediente
            {
                ExpedienteId = expediente.Id,
                TipoActuacionId = 9,
                Titulo = "Publicación del 3er Aviso en La Gaceta (ENAG) - Plazo de Oposición",
                Comentario = $"Tercer aviso publicado el {hoy:dd/MM/yyyy}. Corre el plazo de 30 días hábiles para oposiciones de terceros.",
                FechaActuacion = hoy,
                UsuarioResponsable = expediente.ParalegalAsignado ?? "Paralegal Encargado"
            }, 16); // En Período de Oposición (30 días)
        }

        await ExpedienteService.GuardarPublicacionENAGAsync(publicacionActual, expediente.ParalegalAsignado ?? "Paralegal Encargado");
        NotificationService.Notify(NotificationSeverity.Success, "Publicación", $"Se registró el Aviso {numeroAviso} en La Gaceta.");
        await CargarExpediente();
    }


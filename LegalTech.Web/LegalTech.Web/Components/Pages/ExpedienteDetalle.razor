    private async Task CambiarPresetPlazo(string codigo)
    {
        presetPlazoSeleccionado = codigo;
        var preset = presetsDisponibles.FirstOrDefault(p => p.Codigo == codigo);
        if (preset != null)
        {
            conceptoPlazoNuevo = preset.ConceptoDefault;
            diasHabilesNuevo = preset.DiasHabiles;
        }
        await ActualizarProyeccionVencimiento();
    }


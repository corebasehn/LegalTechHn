@page "/expedientes/{Id:guid}"
@rendermode InteractiveServer
@using LegalTech.Web.Domain.Entities
@using LegalTech.Web.Domain.Enums
@using LegalTech.Web.Services
@inject ExpedienteService ExpedienteService
@inject ClienteService ClienteService
@inject CatalogoService CatalogoService
@inject PlazosService PlazosService
@inject LitigioService LitigioService
@inject FacturacionService FacturacionService
@inject DocumentoService DocumentoService
@inject ConfiguracionService ConfiguracionService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>@(expediente?.DenominacionMarca ?? "Expediente") - Detalle y Línea de Tiempo</PageTitle>

<div class="w-100 p-2 p-md-3">
    <!-- Botón Volver y Breadcrumb -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <RadzenButton Icon="arrow_back" Text="Volver al Listado" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                      Click="@(() => NavigationManager.NavigateTo("/expedientes"))" />
        <div class="text-muted small">
            <RadzenIcon Icon="folder" Class="me-1" /> LegalTech Honduras / Expedientes / @(expediente?.CodigoInterno ?? "Cargando...")
        </div>
    </div>

    @if (cargando)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="my-4" />
    }
    else if (expediente == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">
            El expediente solicitado no existe o fue eliminado.
        </RadzenAlert>
    }
    else
    {
        @if (plazoMasUrgente.Plazo != null && plazoMasUrgente.Semaforo != null)
        {
            <RadzenAlert AlertStyle="@(plazoMasUrgente.Semaforo.NivelRiesgo == "Critico" || plazoMasUrgente.Semaforo.NivelRiesgo == "Vencido" ? AlertStyle.Danger : plazoMasUrgente.Semaforo.NivelRiesgo == "Alerta" ? AlertStyle.Warning : AlertStyle.Success)" 
                         Variant="@(plazoMasUrgente.Semaforo.NivelRiesgo == "Critico" ? Variant.Filled : Variant.Flat)" 
                         Class="mb-3 shadow-sm border-0" AllowClose="false">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <RadzenIcon Icon="@plazoMasUrgente.Semaforo.Icono" Class="fs-3" />
                        <div>
                            <strong>TÉRMINO FATAL EN CURSO (Art. 42 LPA):</strong> @plazoMasUrgente.Plazo.Concepto &mdash; 
                            <span class="badge @(plazoMasUrgente.Semaforo.NivelRiesgo == "Critico" ? "bg-white text-danger fw-bold" : "bg-dark text-white")">
                                @plazoMasUrgente.Semaforo.TextoBadge
                            </span> 
                            (Vence: <u>@plazoMasUrgente.Plazo.FechaVencimientoFatal.ToString("dd/MM/yyyy")</u>)
                            <div class="small mt-1">@plazoMasUrgente.Semaforo.MensajeAccion</div>
                        </div>
                    </div>
                    <RadzenButton Icon="timer" Text="Ir a Plazos y Vencimientos" ButtonStyle="@(plazoMasUrgente.Semaforo.NivelRiesgo == "Critico" ? ButtonStyle.Light : ButtonStyle.Primary)" Size="ButtonSize.Small" 
                                  Click="@(() => tabPrincipalIndex = 2)" />
                </div>
            </RadzenAlert>
        }

        <!-- Resumen Maestro Superior (Header Card) -->
        <RadzenCard Class="mb-3 p-3 p-md-4 shadow-sm border-0 bg-white">
            <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenColumn Size="12" SizeMD="8">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(expediente.ArchivoEtiquetaJpgUri))
                        {
                            <div class="flex-shrink-0">
                                <img src="@expediente.ArchivoEtiquetaJpgUri" alt="Logo de la marca" 
                                     class="rounded border p-1 bg-white shadow-xs" 
                                     style="width: 72px; height: 72px; object-fit: contain;" />
                            </div>
                        }
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="badge bg-dark font-monospace fs-6 px-3 py-2">@expediente.CodigoInterno</span>
                                <RadzenBadge BadgeStyle="@GetBadgeStyleFromColor(expediente.EstadoProcesal?.ColorBadge)" 
                                             Text="@(expediente.EstadoProcesal?.Nombre ?? "En Trámite")" 
                                             Size="BadgeSize.Medium" Class="px-2 py-1" />
                                <span class="badge bg-secondary-subtle text-secondary border">Fase: @(expediente.EstadoProcesal?.Fase ?? "Apertura")</span>
                            </div>

                            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" Class="m-0 text-primary fw-bold text-break">
                                @expediente.DenominacionMarca
                            </RadzenText>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-3 mt-2 text-muted small">
                        <div>
                            <RadzenIcon Icon="business" Class="me-1 text-primary" />
                            <strong>Titular:</strong> @(expediente.Cliente?.NombreRazonSocial ?? "No asignado")
                        </div>
                        <div>
                            <RadzenIcon Icon="category" Class="me-1 text-info" />
                            <strong>Tipo de Signo:</strong> @(expediente.TipoSigno?.Nombre ?? "No definido")
                        </div>
                        <div>
                            <RadzenIcon Icon="tag" Class="me-1 text-success" />
                            <strong>Clase Niza:</strong> Clase @expediente.ClaseNiza (@ObtenerDetalleClase(expediente.ClaseNiza))
                        </div>
                    </div>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="4" Class="text-md-end border-start-md ps-md-3">
                    <div class="p-2 rounded bg-light text-start mb-2">
                        <small class="text-muted d-block">Presentación Oficial DIGEPIH</small>
                        <strong class="fs-6 text-dark">
                            @(string.IsNullOrWhiteSpace(expediente.NumeroExpedienteDIGEPIH) ? "Sin No. Oficial Asignado" : $"No. {expediente.NumeroExpedienteDIGEPIH}")
                        </strong>
                        <div class="small text-muted">
                            Fecha: @(expediente.FechaPresentacionOficial?.ToString("dd/MM/yyyy") ?? "Pendiente")
                        </div>
                    </div>

                    <!-- Selector Rápido de Cambio de Estado Procesal (desde tabla en BD) -->
                    <div class="d-flex align-items-center justify-content-md-end gap-2">
                        <span class="small text-muted">Cambiar Estado:</span>
                        <RadzenDropDown TValue="int" Value="@expediente.EstadoProcesalId" 
                                        Data="@estadosProcesales" TextProperty="Nombre" ValueProperty="Id"
                                        ValueChanged="@(async (int nuevoId) => await CambiarEstadoProcesalRapido(nuevoId))"
                                        Style="max-width: 220px; font-size: 0.8rem;" />
                    </div>
                </RadzenColumn>
            </RadzenRow>

            <!-- Pipeline Visual de Fases Procesales del Trámite en Honduras -->
            <div class="d-none d-lg-flex align-items-center justify-content-between p-2 mt-3 bg-light rounded border">
                <div class="text-center flex-fill px-2 py-1 rounded @GetFaseClass("Apertura")">
                    <RadzenIcon Icon="folder_open" Class="d-block mx-auto mb-1 fs-5" />
                    <small class="fw-bold">1. Apertura / Búsqueda</small>
                </div>
                <RadzenIcon Icon="chevron_right" Class="text-muted" />
                <div class="text-center flex-fill px-2 py-1 rounded @GetFaseClass("Presentación")">
                    <RadzenIcon Icon="assignment_turned_in" Class="d-block mx-auto mb-1 fs-5" />
                    <small class="fw-bold">2. Presentación DIGEPIH</small>
                </div>
                <RadzenIcon Icon="chevron_right" Class="text-muted" />
                <div class="text-center flex-fill px-2 py-1 rounded @GetFaseClass("Examen")">
                    <RadzenIcon Icon="rule" Class="d-block mx-auto mb-1 fs-5" />
                    <small class="fw-bold">3. Examen (Forma/Fondo)</small>
                </div>
                <RadzenIcon Icon="chevron_right" Class="text-muted" />
                <div class="text-center flex-fill px-2 py-1 rounded @(GetFaseClass("Publicación") != "" ? GetFaseClass("Publicación") : GetFaseClass("Oposición"))">
                    <RadzenIcon Icon="newspaper" Class="d-block mx-auto mb-1 fs-5" />
                    <small class="fw-bold">4. Publicación La Gaceta</small>
                </div>
                <RadzenIcon Icon="chevron_right" Class="text-muted" />
                <div class="text-center flex-fill px-2 py-1 rounded @(GetFaseClass("Concesión") != "" ? GetFaseClass("Concesión") : GetFaseClass("Vigilancia"))">
                    <RadzenIcon Icon="workspace_premium" Class="d-block mx-auto mb-1 fs-5" />
                    <small class="fw-bold">5. Concesión y Título</small>
                </div>
            </div>
        </RadzenCard>

        <!-- Pestañas Modulares del Expediente Marcario -->
        <RadzenTabs @bind-SelectedIndex="tabPrincipalIndex" RenderMode="TabRenderMode.Client" Class="shadow-sm bg-white rounded">
            <Tabs>
                <!-- PESTAÑA 1: FICHA REGISTRAL Y PRESENTACIÓN DIGEPIH -->
                <RadzenTabsItem Text="Ficha y Presentación DIGEPIH" Icon="description">
                    <div class="p-3">
                        <RadzenTemplateForm TItem="Expediente" Data="@expediente" Submit="@GuardarFichaGeneral">
                            <RadzenRow Gap="1rem">
                                <!-- SECCIÓN 1: DATOS GENERALES DEL SIGNO -->
                                <RadzenColumn Size="12">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="fw-bold text-primary border-bottom pb-1 mb-2">
                                        1. Datos Generales de la Solicitud y Signo Distintivo
                                    </RadzenText>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Titular / Solicitante (Tabla Clientes)" Class="w-100">
                                        <RadzenDropDown @bind-Value="expediente.ClienteId" Data="@clientes" TextProperty="NombreRazonSocial" ValueProperty="Id" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Denominación de la Marca" Class="w-100">
                                        <RadzenTextBox @bind-Value="expediente.DenominacionMarca" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Tipo de Signo (Tabla TiposSigno en BD)" Class="w-100">
                                        <RadzenDropDown @bind-Value="expediente.TipoSignoId" Data="@tiposSigno" 
                                                        TextProperty="Nombre" ValueProperty="Id" 
                                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenFormField Text="Clase Internacional de Niza (Buscador Select2 1 a 45)" Class="w-100">
                                        <RadzenDropDown @bind-Value="expediente.ClaseNiza" Data="@catalogoNiza" 
                                                        TextProperty="DisplayText" ValueProperty="Numero" 
                                                        AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" 
                                                        FilterOperator="StringFilterOperator.Contains" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Size="AlertSize.Small" Class="mb-1" AllowClose="false">
                                        <b>Criterio Exigido por DIGEPIH Honduras:</b> Debe especificar detalladamente los productos o servicios. Se rechazan clasificaciones abiertas o genéricas.
                                    </RadzenAlert>
                                    <RadzenFormField Text="Descripción Específica de Productos y Servicios" Class="w-100">
                                        <RadzenTextArea @bind-Value="expediente.DescripcionEspecificaProductosServicios" Rows="3" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <!-- SECCIÓN 2: PRESENTACIÓN FORMAL ANTE DIGEPIH -->
                                <RadzenColumn Size="12" Class="mt-3">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="fw-bold text-primary border-bottom pb-1 mb-2">
                                        2. Presentación Formal y Prioridad Legal en Honduras
                                    </RadzenText>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="No. Expediente DIGEPIH" Class="w-100">
                                        <RadzenTextBox @bind-Value="expediente.NumeroExpedienteDIGEPIH" Placeholder="Ej: 2026-00482" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Fecha de Presentación Oficial" Class="w-100">
                                        <RadzenDatePicker @bind-Value="expediente.FechaPresentacionOficial" DateFormat="dd/MM/yyyy" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Vía de Presentación (Tabla ViasPresentacion)" Class="w-100">
                                        <RadzenDropDown @bind-Value="expediente.ViaPresentacionId" Data="@viasPresentacion" 
                                                        TextProperty="Nombre" ValueProperty="Id" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12">
                                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 p-2 p-md-3 rounded bg-primary-subtle border border-primary-subtle">
                                        <div>
                                            <strong class="text-primary"><RadzenIcon Icon="verified" Class="me-1" /> Registrar Presentación Oficial ante DIGEPIH</strong>
                                            <div class="small text-muted">
                                                Fija la prioridad legal en Honduras, genera automáticamente el hito en la bitácora y avanza el estado a 'Presentado ante DIGEPIH'.
                                            </div>
                                        </div>
                                        <RadzenButton Icon="how_to_reg" Text="Asentar Presentación Oficial" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                      Click="@RegistrarPresentacionOficialFormal" />
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="p-3 border rounded bg-light h-100">
                                        <RadzenText TextStyle="TextStyle.Caption" Class="fw-bold d-block mb-2 text-uppercase">
                                            Requisitos Físicos Formales (Manual DIGEPIH)
                                        </RadzenText>
                                        <div class="d-flex flex-column gap-2">
                                            <div>
                                                <RadzenCheckBox @bind-Value="expediente.TimbreL50Pagado" Name="chkTimbre" />
                                                <RadzenLabel Text="Timbre de Contratación de L 50.00 adherido" Component="chkTimbre" Class="ms-2" />
                                            </div>
                                            <div>
                                                <RadzenCheckBox @bind-Value="expediente.EtiquetasFisicas2x4Entregadas" Name="chkEtiq" />
                                                <RadzenLabel Text="20 Etiquetas Físicas formato 2 x 4 pulgadas entregadas" Component="chkEtiq" Class="ms-2" />
                                            </div>
                                            <div>
                                                <RadzenCheckBox @bind-Value="expediente.TasasOficialesPagadas" Name="chkTasas" />
                                                <RadzenLabel Text="Tasas oficiales de registro canceladas ante el IP" Component="chkTasas" Class="ms-2" />
                                            </div>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="p-3 border rounded bg-light h-100">
                                        <RadzenText TextStyle="TextStyle.Caption" Class="fw-bold d-block mb-2 text-uppercase">
                                            Reivindicación de Prioridad (Convenio de París)
                                        </RadzenText>
                                        <div class="mb-2">
                                            <RadzenCheckBox @bind-Value="expediente.ReivindicaPrioridad" Name="chkPrio" />
                                            <RadzenLabel Text="¿Reivindica prioridad de solicitud extranjera previa?" Component="chkPrio" Class="ms-2" />
                                        </div>
                                        @if (expediente.ReivindicaPrioridad)
                                        {
                                            <div class="d-flex flex-column gap-2 mt-2">
                                                <RadzenTextBox @bind-Value="expediente.PaisPrioridad" Placeholder="País de prioridad (ej: EE.UU., México)" Class="w-100" />
                                                <div class="d-flex gap-2">
                                                    <RadzenDatePicker @bind-Value="expediente.FechaPrioridad" DateFormat="dd/MM/yyyy" Placeholder="Fecha solicitud" Class="w-50" />
                                                    <RadzenTextBox @bind-Value="expediente.NumeroSolicitudPrioridad" Placeholder="No. Solicitud extranjera" Class="w-50" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </RadzenColumn>

                                <!-- SECCIÓN 3: RESPONSABLES INTERNOS -->
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Abogado Responsable" Class="w-100">
                                        <RadzenTextBox @bind-Value="expediente.AbogadoResponsable" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Paralegal Asignado" Class="w-100">
                                        <RadzenTextBox @bind-Value="expediente.ParalegalAsignado" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" Class="text-end mt-3">
                                    <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Guardar Cambios de Ficha" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenTemplateForm>
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 2: LÍNEA DE TIEMPO PROCESAL (TIMELINE) -->
                <RadzenTabsItem Text="Línea de Tiempo Procesal" Icon="timeline">
                    <div class="p-3">
                        <RadzenRow Gap="1.5rem">
                            <!-- Columna Izquierda: Cronología de Actuaciones -->
                            <RadzenColumn Size="12" SizeMD="7">
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <RadzenText TextStyle="TextStyle.H6" Class="m-0 text-primary fw-bold">
                                        <RadzenIcon Icon="history" Class="me-1" /> Historial de Actuaciones y Notificaciones
                                    </RadzenText>
                                    <span class="badge bg-light text-dark border">@expediente.Actuaciones.Count actuaciones</span>
                                </div>

                                @if (!expediente.Actuaciones.Any())
                                {
                                    <div class="text-center p-4 border rounded bg-light text-muted">
                                        <RadzenIcon Icon="hourglass_empty" Style="font-size: 2rem;" />
                                        <p class="m-0 mt-2">No hay actuaciones registradas en este expediente aún.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-container d-flex flex-column gap-3">
                                        @foreach (var act in expediente.Actuaciones.OrderByDescending(a => a.FechaActuacion))
                                        {
                                            <RadzenCard Class="p-3 shadow-xs border-start border-4" 
                                                        Style="@($"border-left-color: var(--rz-{(act.TipoActuacion?.Color ?? "primary")}) !important; border-top: 1px solid #e9ecef; border-right: 1px solid #e9ecef; border-bottom: 1px solid #e9ecef;")">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                            <RadzenIcon Icon="@(act.TipoActuacion?.Icono ?? "event_note")" 
                                                                        Class="@($"text-{(act.TipoActuacion?.Color ?? "primary")}")" />
                                                            <strong class="text-dark fs-6">@act.Titulo</strong>
                                                        </div>
                                                        <span class="badge bg-light text-secondary border me-2" style="font-size: 0.7rem;">
                                                            @(act.TipoActuacion?.Nombre ?? "Hito Procesal")
                                                        </span>
                                                        <small class="text-muted">
                                                            <RadzenIcon Icon="person" Style="font-size: 0.85rem;" /> @act.UsuarioResponsable
                                                        </small>
                                                    </div>
                                                    <span class="badge bg-dark font-monospace" style="font-size: 0.75rem;">
                                                        @act.FechaActuacion.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(act.Comentario))
                                                {
                                                    <div class="mt-2 p-2 bg-light rounded text-secondary small">
                                                        @act.Comentario
                                                    </div>
                                                }
                                            </RadzenCard>
                                        }
                                    </div>
                                }
                            </RadzenColumn>

                            <!-- Columna Derecha: Formulario para Agregar Nuevo Hito -->
                            <RadzenColumn Size="12" SizeMD="5">
                                <RadzenCard Class="p-3 p-md-4 shadow-sm border bg-light">
                                    <RadzenText TextStyle="TextStyle.H6" Class="fw-bold text-primary mb-3">
                                        <RadzenIcon Icon="post_add" Class="me-1" /> Registrar Nuevo Hito Procesal
                                    </RadzenText>

                                    <RadzenTemplateForm TItem="ActuacionExpediente" Data="@nuevaActuacion" Submit="@RegistrarNuevoHito">
                                        <div class="d-flex flex-column gap-3">
                                            <RadzenFormField Text="Tipo de Actuación (Tabla TiposActuaciones en BD)" Class="w-100">
                                                <RadzenDropDown @bind-Value="nuevaActuacion.TipoActuacionId" 
                                                                Data="@tiposActuaciones" TextProperty="Nombre" ValueProperty="Id"
                                                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Class="w-100" />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Título del Hito / Resolución" Class="w-100">
                                                <RadzenTextBox @bind-Value="nuevaActuacion.Titulo" Placeholder="Ej: Notificación de Auto de Prevención" Class="w-100" />
                                            </RadzenFormField>

                                            <div class="d-flex gap-2">
                                                <RadzenFormField Text="Fecha y Hora" Class="w-50">
                                                    <RadzenDatePicker @bind-Value="nuevaActuacion.FechaActuacion" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Class="w-100" />
                                                </RadzenFormField>
                                                <RadzenFormField Text="Responsable" Class="w-50">
                                                    <RadzenTextBox @bind-Value="nuevaActuacion.UsuarioResponsable" Class="w-100" />
                                                </RadzenFormField>
                                            </div>

                                            <RadzenFormField Text="Comentario / Fundamentación Jurídica" Class="w-100">
                                                <RadzenTextArea @bind-Value="nuevaActuacion.Comentario" Rows="3" Placeholder="Detalle de la actuación, plazo legal otorgado o términos procesales..." Class="w-100" />
                                            </RadzenFormField>

                                            <div class="p-2 border rounded bg-white">
                                                <RadzenText TextStyle="TextStyle.Caption" Class="fw-bold mb-1 text-muted d-block">
                                                    ¿Avanzar Estado Procesal? (Opcional)
                                                </RadzenText>
                                                <RadzenDropDown @bind-Value="nuevoEstadoParaActuacion" Data="@estadosProcesales" 
                                                                TextProperty="Nombre" ValueProperty="Id" AllowClear="true" 
                                                                Placeholder="Dejar estado actual sin cambios" Class="w-100" />
                                            </div>

                                            <RadzenButton ButtonType="ButtonType.Submit" Icon="add_task" Text="Agregar a Línea de Tiempo" 
                                                          ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium" Class="w-100 mt-2" />
                                        </div>
                                    </RadzenTemplateForm>
                                </RadzenCard>
                            </RadzenColumn>
                        </RadzenRow>
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 3: MOTOR DE PLAZOS LEGALES Y VENCIMIENTOS (ART. 42 LPA) -->
                <RadzenTabsItem Text="Plazos y Vencimientos" Icon="timer">
                    <div class="p-3">
                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <RadzenText TextStyle="TextStyle.H6" Class="m-0 text-primary fw-bold">
                                    <RadzenIcon Icon="timer" Class="me-1" /> Motor de Plazos Legales y Vencimientos Fatales
                                </RadzenText>
                                <small class="text-muted">
                                    Cálculo en días hábiles procesales de Honduras (Art. 42 LPA, Art. 88 LPI). Excluye automáticamente sábados, domingos y feriados nacionales.
                                </small>
                            </div>
                            <RadzenButton Icon="@(mostrandoFormNuevoPlazo ? "expand_less" : "add_alarm")" 
                                          Text="@(mostrandoFormNuevoPlazo ? "Ocultar Formulario" : "Registrar Plazo Procesal")" 
                                          ButtonStyle="@(mostrandoFormNuevoPlazo ? ButtonStyle.Light : ButtonStyle.Success)" 
                                          Size="ButtonSize.Small" Click="@(() => mostrandoFormNuevoPlazo = !mostrandoFormNuevoPlazo)" />
                        </div>

                        <!-- FORMULARIO DESPLEGABLE: APERTURA DE TÉRMINO FATAL -->
                        @if (mostrandoFormNuevoPlazo)
                        {
                            <RadzenCard Class="p-3 mb-4 bg-light border border-primary shadow-sm">
                                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                                    <strong class="text-primary">
                                        <RadzenIcon Icon="add_alarm" Class="me-1" /> Apertura de Término Legal Perentorio (Honduras)
                                    </strong>
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => mostrandoFormNuevoPlazo = false)" />
                                </div>

                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Tipo de Plazo / Preconfiguración Legal" Class="w-100">
                                            <RadzenDropDown TValue="string" Value="@presetPlazoSeleccionado" 
                                                            Data="@presetsDisponibles" TextProperty="Nombre" ValueProperty="Codigo"
                                                            ValueChanged="@(async (string v) => await CambiarPresetPlazo(v))"
                                                            Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Concepto o Requerimiento Oficial" Class="w-100">
                                            <RadzenTextBox @bind-Value="conceptoPlazoNuevo" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Fecha de Notificación Oficial" Class="w-100">
                                            <RadzenDatePicker @bind-Value="fechaNotificacionNuevo" DateFormat="dd/MM/yyyy" 
                                                              Change="@(async (DateTime? v) => await ActualizarProyeccionVencimiento())" Class="w-100" />
                                        </RadzenFormField>
                                        <small class="text-muted d-block mt-1">El cómputo inicia el día hábil siguiente (Art. 42 LPA).</small>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenFormField Text="Días Hábiles Otorgados" Class="w-100">
                                            <RadzenNumeric @bind-Value="diasHabilesNuevo" Min="1" Max="365" 
                                                           Change="@(async (int v) => await ActualizarProyeccionVencimiento())" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>

                                    <!-- WIDGET DE PROYECCIÓN AUTOMÁTICA -->
                                    <RadzenColumn Size="12" SizeMD="5">
                                        <div class="p-3 border rounded bg-white h-100 shadow-xs">
                                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.72rem;">
                                                <RadzenIcon Icon="event_available" Class="text-success me-1" /> Fecha Fatal Calculada
                                            </small>
                                            <strong class="fs-6 text-danger d-block">
                                                @fechaFatalProyectada.ToString("dddd, dd 'de' MMMM 'de' yyyy")
                                            </strong>
                                            <small class="text-muted">
                                                Excluye fines de semana y feriados oficiales de la República de Honduras.
                                            </small>
                                        </div>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12">
                                        <RadzenFormField Text="Observaciones / Fundamento Legal de la Notificación" Class="w-100">
                                            <RadzenTextBox @bind-Value="observacionesPlazoNuevo" Placeholder="Ej: Auto No. 124-2026 notificado en tabla de avisos de DIGEPIH..." Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" Class="text-end">
                                        <RadzenButton Icon="timer" Text="Registrar Término Fatal en el Expediente" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" 
                                                      Click="@RegistrarNuevoPlazoProcesal" Class="me-2" />
                                        <RadzenButton Icon="cancel" Text="Cancelar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => mostrandoFormNuevoPlazo = false)" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenCard>
                        }

                        <!-- MODAL / FORMULARIO PARA EVACUAR PLAZO -->
                        @if (plazoAEvacuar != null)
                        {
                            <RadzenCard Class="p-3 mb-4 bg-white border border-success shadow-sm">
                                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                                    <strong class="text-success">
                                        <RadzenIcon Icon="task_alt" Class="me-1" /> Evacuación / Cumplimiento de Plazo Legal: @plazoAEvacuar.Concepto
                                    </strong>
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => plazoAEvacuar = null)" />
                                </div>
                                <p class="text-secondary small mb-2">
                                    Registrar la fecha en que se presentó el escrito de contestación o subsanación ante DIGEPIH para cerrar el cómputo y asentar el hito en la línea de tiempo.
                                </p>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeMD="4">
                                        <RadzenFormField Text="Fecha de Presentación del Escrito" Class="w-100">
                                            <RadzenDatePicker @bind-Value="fechaCumplimientoModal" DateFormat="dd/MM/yyyy" Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="8">
                                        <RadzenFormField Text="Constancia / No. de Recibo o Resumen del Escrito" Class="w-100">
                                            <RadzenTextBox @bind-Value="notaCumplimientoModal" Placeholder="Ej: Escrito de contestación radicado en ventanilla con copia sellada..." Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" Class="text-end">
                                        <RadzenButton Icon="check_circle" Text="Confirmar Evacuación" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Click="@ConfirmarEvacuacionPlazo" Class="me-2" />
                                        <RadzenButton Icon="cancel" Text="Cancelar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => plazoAEvacuar = null)" />
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenCard>
                        }

                        <!-- TABLA DE PLAZOS Y ESTADO DEL SEMÁFORO -->
                        @if (!plazosExpediente.Any())
                        {
                            <div class="text-center p-4 border rounded bg-light text-muted">
                                <RadzenIcon Icon="event_available" Style="font-size: 2.5rem;" Class="text-success" />
                                <h6 class="mt-2 text-dark">Sin Plazos Fatales Pendientes</h6>
                                <p class="m-0 small">Este expediente no tiene términos procesales pendientes de evacuación.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive w-100">
                                <RadzenDataGrid Data="@plazosExpediente" TItem="PlazoLegal" AllowSorting="true" AllowPaging="true" PageSize="6" Style="width: 100%;">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="PlazoLegal" Property="Concepto" Title="Concepto / Término Legal" Width="260px">
                                            <Template Context="p">
                                                <strong>@p.Concepto</strong>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="PlazoLegal" Property="DiasHabiles" Title="Días Hábiles" Width="100px" TextAlign="TextAlign.Center">
                                            <Template Context="p">
                                                <span class="badge bg-light text-dark border">@p.DiasHabiles d.h.</span>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="PlazoLegal" Property="FechaInicio" Title="Notificación" Width="110px">
                                            <Template Context="p">
                                                @p.FechaInicio.ToString("dd/MM/yyyy")
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="PlazoLegal" Property="FechaVencimientoFatal" Title="Vencimiento Fatal" Width="130px">
                                            <Template Context="p">
                                                <strong class="text-danger">@p.FechaVencimientoFatal.ToString("dd/MM/yyyy")</strong>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <!-- SEMÁFORO PROCESAL HONDUREÑO -->
                                        <RadzenDataGridColumn TItem="PlazoLegal" Title="Semáforo / Días Restantes" Width="220px">
                                            <Template Context="p">
                                                @if (semaforosPlazos.TryGetValue(p.Id, out var sem))
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <RadzenBadge BadgeStyle="@GetBadgeStyleFromColor(sem.ColorBadge)" 
                                                                     Text="@sem.TextoBadge" Size="BadgeSize.Small" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Calculando...</span>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="PlazoLegal" Property="Cumplido" Title="Estado" Width="130px" TextAlign="TextAlign.Center">
                                            <Template Context="p">
                                                @if (p.Cumplido)
                                                {
                                                    <span class="badge bg-success" title="@p.FechaCumplimiento?.ToString("dd/MM/yyyy")">
                                                        <RadzenIcon Icon="check" Style="font-size: 0.75rem;" /> Evacuado
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <RadzenIcon Icon="pending" Style="font-size: 0.75rem;" /> En Curso
                                                    </span>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="PlazoLegal" Title="Acciones" Width="140px" TextAlign="TextAlign.Center">
                                            <Template Context="p">
                                                @if (!p.Cumplido)
                                                {
                                                    <RadzenButton Icon="task_alt" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.ExtraSmall" 
                                                                  Text="Evacuar" Click="@(() => AbrirModalEvacuarPlazo(p))" Class="me-1" />
                                                }
                                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" 
                                                              Click="@(() => EliminarPlazoProcesal(p.Id))" title="Eliminar" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 4: CICLO LA GACETA (ENAG) -->
                <RadzenTabsItem Text="Ciclo La Gaceta (ENAG)" Icon="newspaper">
                    <div class="p-3">
                        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Class="mb-3" AllowClose="false">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="warning" Class="fs-4 text-warning" />
                                <div>
                                    <strong>REGLA FATAL DE ABANDONO (Manual de Marcas de Honduras):</strong>
                                    La marca debe publicarse 3 veces en <i>La Gaceta Oficial</i> (con intervalos aproximados de 15 días). 
                                    Posteriormente, deben comprarse los <b>tres ejemplares físicos originales</b> y entregarse formalmente ante DIGEPIH. 
                                    El incumplimiento de este depósito físico acarrea la declaratoria de abandono de la solicitud.
                                </div>
                            </div>
                        </RadzenAlert>

                        <RadzenTemplateForm TItem="PublicacionENAG" Data="@publicacionActual" Submit="@GuardarPublicacion">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="No. de Aviso Oficial emitido por DIGEPIH" Class="w-100">
                                        <RadzenTextBox @bind-Value="publicacionActual.NumeroAvisoDIGEPIH" Placeholder="Ej: AV-2026-0391" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="No. de Recibo de Pago a ENAG" Class="w-100">
                                        <RadzenTextBox @bind-Value="publicacionActual.ReciboPagoENAG" Placeholder="Ej: ENAG-REC-88492" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <!-- LAS 3 PUBLICACIONES OBLIGATORIAS -->
                                <RadzenColumn Size="12">
                                    <RadzenCard Class="p-3 border bg-light">
                                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold mb-2 text-dark">
                                            Fechas de las 3 Publicaciones Obligatorias en La Gaceta
                                        </RadzenText>
                                        <RadzenRow Gap="0.75rem">
                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Aviso 1 (Publicación Inicial)" Class="w-100">
                                                    <RadzenDatePicker @bind-Value="publicacionActual.FechaPublicacionAviso1" DateFormat="dd/MM/yyyy" Class="w-100" />
                                                </RadzenFormField>
                                                @if (!publicacionActual.FechaPublicacionAviso1.HasValue)
                                                {
                                                    <RadzenButton Text="Registrar Hoy Aviso 1" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" 
                                                                  Click="@(() => RegistrarAvisoHoy(1))" Class="mt-1 w-100" />
                                                }
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Aviso 2 (~15 días después)" Class="w-100">
                                                    <RadzenDatePicker @bind-Value="publicacionActual.FechaPublicacionAviso2" DateFormat="dd/MM/yyyy" Class="w-100" />
                                                </RadzenFormField>
                                                @if (publicacionActual.FechaPublicacionAviso1.HasValue && !publicacionActual.FechaPublicacionAviso2.HasValue)
                                                {
                                                    <RadzenButton Text="Registrar Hoy Aviso 2" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" 
                                                                  Click="@(() => RegistrarAvisoHoy(2))" Class="mt-1 w-100" />
                                                }
                                            </RadzenColumn>

                                            <RadzenColumn Size="12" SizeMD="4">
                                                <RadzenFormField Text="Aviso 3 (~15 días después)" Class="w-100">
                                                    <RadzenDatePicker @bind-Value="publicacionActual.FechaPublicacionAviso3" DateFormat="dd/MM/yyyy" 
                                                                      Change="@CalcularFinOposicion" Class="w-100" />
                                                </RadzenFormField>
                                                @if (publicacionActual.FechaPublicacionAviso2.HasValue && !publicacionActual.FechaPublicacionAviso3.HasValue)
                                                {
                                                    <RadzenButton Text="Registrar Hoy Aviso 3" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" 
                                                                  Click="@(() => RegistrarAvisoHoy(3))" Class="mt-1 w-100" />
                                                }
                                            </RadzenColumn>
                                        </RadzenRow>
                                    </RadzenCard>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Término Fatal de Oposiciones de Terceros (30 días hábiles)" Class="w-100">
                                        <RadzenDatePicker @bind-Value="publicacionActual.FechaFinPeriodoOposicion" DateFormat="dd/MM/yyyy" Class="w-100" />
                                    </RadzenFormField>
                                    <small class="text-muted d-block mt-1">Calculado a partir de la fecha de publicación del tercer aviso.</small>
                                </RadzenColumn>

                                <!-- ADQUISICIÓN Y ENTREGA FÍSICA A DIGEPIH -->
                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="p-3 border rounded bg-white h-100">
                                        <RadzenText TextStyle="TextStyle.Caption" Class="fw-bold d-block mb-2 text-uppercase text-danger">
                                            Control de Entrega Física de Ejemplares (Evitar Abandono)
                                        </RadzenText>
                                        <div class="d-flex flex-column gap-2">
                                            <div>
                                                <RadzenCheckBox @bind-Value="publicacionActual.EjemplaresFisicosRecibidos" Name="chkRecib" />
                                                <RadzenLabel Text="Los 3 ejemplares físicos de La Gaceta comprados y recibidos de ENAG" Component="chkRecib" Class="ms-2" />
                                            </div>
                                            <div>
                                                <RadzenCheckBox @bind-Value="publicacionActual.EjemplaresEntregadosDIGEPIH" Name="chkEntreg" />
                                                <RadzenLabel Text="Los 3 ejemplares físicos ENTREGADOS formalmente ante DIGEPIH" Component="chkEntreg" Class="ms-2 fw-bold text-success" />
                                            </div>
                                            @if (publicacionActual.EjemplaresEntregadosDIGEPIH)
                                            {
                                                <div class="mt-1">
                                                    <RadzenFormField Text="Fecha de Entrega Física ante DIGEPIH" Class="w-100">
                                                        <RadzenDatePicker @bind-Value="publicacionActual.FechaEntregaEjemplaresDIGEPIH" DateFormat="dd/MM/yyyy" Class="w-100" />
                                                    </RadzenFormField>
                                                </div>
                                            }
                                            else
                                            {
                                                <RadzenButton Icon="inventory_2" Text="Registrar Entrega de los 3 Ejemplares en DIGEPIH" 
                                                              ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Class="w-100 mt-2" 
                                                              Click="@ConfirmarEntregaEjemplaresFisicos" />
                                            }
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" Class="text-end mt-2">
                                    <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Guardar Ciclo de Publicación" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenTemplateForm>
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 5: TÍTULO OFICIAL Y SOLVENCIA P360 (GATEKEEPER) -->
                <RadzenTabsItem Text="Título y Solvencia P360" Icon="workspace_premium">
                    <div class="p-3">
                        <!-- BANNER Y GESTOR DE SOLVENCIA P360 (MANUAL DE MARCAS PÁRRAFO 360) -->
                        <RadzenCard Class="@(certificadoActual.SolvenciaValidada ? "p-3 mb-3 border-0 shadow-sm bg-white border-start border-success border-4" : "p-3 mb-3 border-0 shadow-sm bg-white border-start border-danger border-4")">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 border-bottom pb-2 mb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <RadzenIcon Icon="@(certificadoActual.SolvenciaValidada ? "verified" : "block")" 
                                                    Class="@(certificadoActual.SolvenciaValidada ? "text-success fs-3" : "text-danger fs-3")" />
                                        <div>
                                            <h6 class="fw-bold m-0 @(certificadoActual.SolvenciaValidada ? "text-success" : "text-danger")">
                                                @(certificadoActual.SolvenciaValidada ? "SOLVENCIA P360 VALIDADA - DESPACHO Y ENTREGA AUTORIZADOS" : "COMPUERTA P360 ACTIVA: TÍTULO BLOQUEADO POR MORA")
                                            </h6>
                                            <small class="text-muted">
                                                @(certificadoActual.SolvenciaValidada 
                                                    ? $"Validado el {certificadoActual.FechaValidacionSolvencia:dd/MM/yyyy HH:mm} por {certificadoActual.ValidadoPorUsuario ?? "Departamento Financiero"}." 
                                                    : "Párrafo 360: Prohibido entregar el título o enviar copias oficiales hasta que el saldo pendiente sea L. 0.00.")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenButton Icon="add_circle" Text="+ Emitir Factura" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                  Click="@(() => NavigationManager.NavigateTo($"/facturacion?expedienteId={expediente?.Id}&nueva=true"))" />
                                    <RadzenButton Icon="sync" Text="Verificar Facturas" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small" 
                                                  Click="@SincronizarSolvenciaConFacturas" title="Validar en tiempo real si el saldo es L. 0.00" />
                                    <RadzenButton Icon="receipt_long" Text="Módulo Cobranzas" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                                  Click="@(() => NavigationManager.NavigateTo($"/facturacion?expedienteId={expediente?.Id}"))" />
                                    @if (certificadoActual.SolvenciaValidada)
                                    {
                                        <RadzenButton Icon="lock_open" Text="Revocar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                                      Click="@(() => AlternarSolvencia(false))" />
                                    }
                                    else
                                    {
                                        <RadzenButton Icon="verified_user" Text="Aprobar Solvencia (Supervisión)" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                                      Click="@(() => AlternarSolvencia(true))" title="Autorización manual excepcional por apoderado" />
                                    }
                                </div>
                            </div>

                            <!-- RESUMEN FINANCIERO DEL CASO -->
                            <RadzenRow Gap="1rem" Class="mb-3">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="p-2 border rounded bg-light">
                                        <small class="text-muted d-block">Total Facturado (HNL)</small>
                                        <strong class="fs-6 text-dark">L @(facturasExpediente.Where(f => f.Moneda == "HNL").Sum(f => f.TotalFactura).ToString("N2"))</strong>
                                        <div class="small text-muted">$ @(facturasExpediente.Where(f => f.Moneda == "USD").Sum(f => f.TotalFactura).ToString("N2")) USD</div>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="p-2 border rounded bg-light">
                                        <small class="text-muted d-block">Total Cobrado / Pagado</small>
                                        <strong class="fs-6 text-success">L @(facturasExpediente.Where(f => f.Moneda == "HNL").Sum(f => f.MontoPagado).ToString("N2"))</strong>
                                        <div class="small text-muted">@facturasExpediente.Count(f => f.Estado == EstadoFactura.Pagada) factura(s) saldada(s)</div>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="4">
                                    <div class="p-2 border rounded @(saldoPendienteExpediente > 0 ? "bg-danger bg-opacity-10 border-danger" : "bg-success bg-opacity-10 border-success")">
                                        <small class="@(saldoPendienteExpediente > 0 ? "text-danger" : "text-success") fw-bold d-block">Saldo Pendiente</small>
                                        <strong class="fs-5 @(saldoPendienteExpediente > 0 ? "text-danger" : "text-success")">L @saldoPendienteExpediente.ToString("N2")</strong>
                                        <div class="small @(saldoPendienteExpediente > 0 ? "text-danger" : "text-success")">
                                            @(saldoPendienteExpediente == 0 ? "Solvente (L. 0.00)" : "Compuerta P360 Bloqueada")
                                        </div>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>

                            <!-- LISTA DE FACTURAS VINCULADAS -->
                            @if (facturasExpediente.Any())
                            {
                                <div class="table-responsive border rounded">
                                    <table class="table table-hover table-sm mb-0 align-middle">
                                        <thead class="table-light small">
                                            <tr>
                                                <th>No. Factura</th>
                                                <th>Fecha</th>
                                                <th>Concepto / Hito</th>
                                                <th class="text-end">Total</th>
                                                <th class="text-end">Saldo Pendiente</th>
                                                <th class="text-center">Estado</th>
                                                <th class="text-end">Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody class="small">
                                            @foreach (var fac in facturasExpediente)
                                            {
                                                <tr>
                                                    <td><strong>@fac.NumeroFactura</strong></td>
                                                    <td>@fac.FechaEmision.ToString("dd/MM/yyyy")</td>
                                                    <td>@(fac.HitoProcesal ?? "Servicios de PI")</td>
                                                    <td class="text-end">@fac.Moneda @fac.TotalFactura.ToString("N2")</td>
                                                    <td class="text-end @(fac.SaldoPendiente > 0 ? "text-danger fw-bold" : "text-success")">
                                                        @fac.Moneda @fac.SaldoPendiente.ToString("N2")
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge @(fac.Estado == EstadoFactura.Pagada ? "bg-success" : (fac.Estado == EstadoFactura.Parcial ? "bg-warning text-dark" : "bg-secondary"))">
                                                            @fac.Estado
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <RadzenButton Icon="receipt" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" 
                                                                      Click="@(() => NavigationManager.NavigateTo($"/facturacion?expedienteId={expediente?.Id}"))" title="Ir a Facturación" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small p-2 bg-light rounded text-center">
                                    No se han generado facturas contables para este caso marcario. 
                                    <a href="/facturacion?expedienteId=@expediente?.Id&nueva=true" class="fw-bold ms-1">Emitir Factura en Facturación</a>
                                </div>
                            }
                        </RadzenCard>

                        <RadzenTemplateForm TItem="CertificadoRegistro" Data="@certificadoActual" Submit="@GuardarCertificado">
                            <RadzenRow Gap="1rem">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="No. de Registro Oficial (Título DIGEPIH)" Class="w-100">
                                        <RadzenTextBox @bind-Value="certificadoActual.NumeroRegistroOficial" Placeholder="Ej: 2026-REG-0112" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Fecha de Concesión Oficial" Class="w-100">
                                        <RadzenDatePicker @bind-Value="certificadoActual.FechaConcesion" DateFormat="dd/MM/yyyy" 
                                                          Change="@CalcularVigenciaDecenal" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenFormField Text="Vencimiento Decenal (10 Años de Vigencia)" Class="w-100">
                                        <RadzenDatePicker @bind-Value="certificadoActual.FechaVencimientoDecenal" DateFormat="dd/MM/yyyy" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenFormField Text="Ubicación Física del Certificado (Tabla UbicacionesArchivo en BD)" Class="w-100">
                                        <RadzenDropDown @bind-Value="certificadoActual.UbicacionArchivoId" Data="@ubicacionesArchivo" 
                                                        TextProperty="Nombre" ValueProperty="Id" Class="w-100" />
                                    </RadzenFormField>
                                </RadzenColumn>

                                <!-- DESPACHO AL CLIENTE (BLOQUEADO SI NO HAY SOLVENCIA P360) -->
                                <RadzenColumn Size="12" SizeMD="6">
                                    <div class="p-3 border rounded bg-light">
                                        <RadzenText TextStyle="TextStyle.Caption" Class="fw-bold d-block mb-1 text-uppercase">
                                            Despacho y Entrega Final al Cliente
                                        </RadzenText>
                                        <div class="d-flex flex-column gap-2">
                                            <RadzenFormField Text="Fecha de Entrega al Cliente" Class="w-100">
                                                <RadzenDatePicker @bind-Value="certificadoActual.FechaEntregaCliente" DateFormat="dd/MM/yyyy" 
                                                                  Disabled="@(!certificadoActual.SolvenciaValidada)" Class="w-100" />
                                            </RadzenFormField>
                                            <RadzenFormField Text="Persona que Recibe / Acuse de Recibo" Class="w-100">
                                                <RadzenTextBox @bind-Value="certificadoActual.FirmaRecepcionClienteUri" 
                                                               Placeholder="Nombre del apoderado o mensajero que firmó acuse" 
                                                               Disabled="@(!certificadoActual.SolvenciaValidada)" Class="w-100" />
                                            </RadzenFormField>
                                        </div>
                                    </div>
                                </RadzenColumn>

                                <RadzenColumn Size="12" Class="text-end mt-2">
                                    <RadzenButton ButtonType="ButtonType.Submit" Icon="save" Text="Guardar Datos del Título" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenTemplateForm>
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 6: LITIGIOS Y OPOSICIONES (DIGEPIH) -->
                <RadzenTabsItem Text="Litigios y Oposiciones" Icon="gavel">
                    <div class="p-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <strong class="fs-6 text-dark d-block">Controversias y Oposiciones del Expediente</strong>
                                <span class="text-muted small">Oposiciones de terceros, contestaciones, objeciones de fondo y recursos</span>
                            </div>
                            <RadzenButton Icon="add" Text="Nueva Controversia" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" 
                                          Click="@(() => NavigationManager.NavigateTo("/litigios"))" />
                        </div>

                        @if (!litigiosExpediente.Any())
                        {
                            <div class="p-4 text-center border rounded bg-light">
                                <RadzenIcon Icon="task_alt" Class="text-success fs-2 mb-2" />
                                <h6 class="fw-bold text-dark mb-1">Sin litigios ni oposiciones activas</h6>
                                <p class="text-muted small mb-0">La solicitud avanza en el trámite ordinario sin demandas de terceros ni denegatorias controvertidas.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr class="small text-muted">
                                            <th>Tipo de Acción</th>
                                            <th>Marca en Conflicto</th>
                                            <th>Partes Procesales</th>
                                            <th>Vencimiento Fatal</th>
                                            <th>Autorización Cliente</th>
                                            <th>Estado</th>
                                            <th class="text-end">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lit in litigiosExpediente)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="badge bg-secondary text-white small">@lit.TipoLitigio</span>
                                                </td>
                                                <td>
                                                    <strong class="text-dark">@lit.MarcaEnConflicto</strong>
                                                </td>
                                                <td class="small">
                                                    <div><b>Dem:</b> @lit.ParteDemandante</div>
                                                    <div><b>Dda:</b> @lit.ParteDemandada</div>
                                                </td>
                                                <td>
                                                    <strong class="text-danger small">@lit.FechaVencimientoFatal.ToString("dd/MM/yyyy")</strong>
                                                </td>
                                                <td>
                                                    @if (lit.AutorizadoPorCliente)
                                                    {
                                                        <span class="badge bg-success">Autorizado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Sin Autorizar</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-info text-white">@lit.Estado</span>
                                                </td>
                                                <td class="text-end">
                                                    <RadzenButton Icon="open_in_new" Text="Gestionar" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" 
                                                                  Click="@(() => NavigationManager.NavigateTo("/litigios"))" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>

                <!-- PESTAÑA 7: REPOSITORIO DOCUMENTAL Y CUSTODIA DIGITAL (MOD-06) -->
                <RadzenTabsItem Text="Documentos y Custodia Digital" Icon="folder_shared">
                    <div class="p-3">
                        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenText TextStyle="TextStyle.H6" Class="m-0 text-primary fw-bold">
                                        <RadzenIcon Icon="folder_shared" Class="me-1" /> Repositorio Digital y Custodia de Archivos
                                    </RadzenText>
                                    <span class="badge @(proveedorAlmacenamientoActivo == "SYNOLOGY" ? "bg-info text-dark" : "bg-primary text-white") small">
                                        @(proveedorAlmacenamientoActivo == "SYNOLOGY" ? "🌐 Synology NAS" : "💻 Servidor Local")
                                    </span>
                                </div>
                                <small class="text-muted">
                                    Custodia digitalizada de logotipos, escritos, autos oficiales, publicaciones de La Gaceta y títulos de concesión.
                                </small>
                            </div>
                            <RadzenButton Icon="@(mostrandoFormSubida ? "expand_less" : "upload_file")" 
                                          Text="@(mostrandoFormSubida ? "Ocultar Subida" : "Subir Nuevo Documento")" 
                                          ButtonStyle="@(mostrandoFormSubida ? ButtonStyle.Light : ButtonStyle.Success)" 
                                          Size="ButtonSize.Small" 
                                          Click="@(() => mostrandoFormSubida = !mostrandoFormSubida)" />
                        </div>

                        <!-- PANEL DE CARGA DE ARCHIVOS (DRAG & DROP / SELECTOR) -->
                        @if (mostrandoFormSubida)
                        {
                            <RadzenCard Class="p-3 mb-4 bg-light border border-primary shadow-sm">
                                <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                                    <strong class="text-primary d-flex align-items-center gap-1">
                                        <RadzenIcon Icon="upload_file" /> Archivar Documento en el Expediente
                                    </strong>
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => mostrandoFormSubida = false)" />
                                </div>

                                <RadzenRow Gap="1rem">
                                    <!-- Selector de Archivo Físico -->
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <label class="form-label small fw-bold text-dark">Seleccionar Archivo (PDF, JPG, PNG, DOCX - Máx 25 MB):</label>
                                        <div class="border border-2 border-dashed rounded p-3 text-center bg-white cursor-pointer hover-bg-light">
                                            <InputFile OnChange="@AlSeleccionarArchivo" class="form-control" />
                                            @if (archivoSeleccionado != null)
                                            {
                                                <div class="mt-2 text-start p-2 bg-light rounded border">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <RadzenIcon Icon="description" Class="text-primary" />
                                                        <strong class="text-truncate">@archivoSeleccionado.Name</strong>
                                                    </div>
                                                    <small class="text-muted d-block">Tamaño: @FormatTamano(archivoSeleccionado.Size) • Tipo: @archivoSeleccionado.ContentType</small>
                                                </div>
                                            }
                                        </div>
                                    </RadzenColumn>

                                    <!-- Tipificación y Clasificación -->
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="d-flex flex-column gap-2">
                                            <RadzenFormField Text="Categoría Documental" Class="w-100">
                                                <RadzenDropDown @bind-Value="categoriaNueva" Data="@categoriasDocumento" Class="w-100" />
                                            </RadzenFormField>

                                            <RadzenFormField Text="Tipo de Documento Oficial" Class="w-100">
                                                <RadzenDropDown @bind-Value="tipoDocumentoNuevo" Data="@tiposDocumentoPredefinidos" 
                                                                AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Class="w-100" />
                                            </RadzenFormField>
                                        </div>
                                    </RadzenColumn>

                                    <!-- Custodia Física en Archivo Central -->
                                    <RadzenColumn Size="12" SizeMD="6">
                                        <div class="p-2 border rounded bg-white">
                                            <div class="d-flex align-items-center mb-2">
                                                <RadzenCheckBox @bind-Value="custodiaFisicaNuevoDoc" Name="chkCustodia" />
                                                <RadzenLabel Text="¿El documento original en papel reposa en la carpeta física?" Component="chkCustodia" Class="ms-2 fw-bold text-dark small" />
                                            </div>
                                            @if (custodiaFisicaNuevoDoc)
                                            {
                                                <RadzenFormField Text="Ubicación Física en Bóveda / Archivo" Class="w-100">
                                                    <RadzenTextBox @bind-Value="ubicacionFisicaNuevoDoc" Placeholder="Ej: Bóveda 1, Gaveta A-2, Carpeta EXP-2026-0001" Class="w-100" />
                                                </RadzenFormField>
                                            }
                                        </div>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" SizeMD="6">
                                        <RadzenFormField Text="Observaciones / Resumen del Documento" Class="w-100">
                                            <RadzenTextBox @bind-Value="observacionesNuevoDoc" Placeholder="Ej: Sellado por ventanilla DIGEPIH con fecha legal..." Class="w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>

                                    <RadzenColumn Size="12" Class="text-end">
                                        @if (subiendoArchivo)
                                        {
                                            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Class="mb-2" />
                                            <span class="text-muted small">Transfiriendo y custodiando archivo...</span>
                                        }
                                        else
                                        {
                                            <RadzenButton Icon="cloud_upload" Text="Subir y Archivar Documento" ButtonStyle="ButtonStyle.Primary" 
                                                          Size="ButtonSize.Small" Click="@SubirArchivoConfirmado" Disabled="@(archivoSeleccionado == null)" Class="me-2" />
                                            <RadzenButton Icon="cancel" Text="Cancelar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" 
                                                          Click="@(() => mostrandoFormSubida = false)" />
                                        }
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenCard>
                        }

                        <!-- BARRA DE FILTROS POR CATEGORÍA -->
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <button type="button" class="btn btn-sm @(filtroCategoriaDoc == "Todas" ? "btn-primary" : "btn-light border")" 
                                    @onclick="@(() => FiltrarPorCategoria("Todas"))">
                                Todos (@documentosExpediente.Count)
                            </button>
                            @foreach (var cat in categoriasDocumento)
                            {
                                int cantidad = documentosExpediente.Count(d => d.Categoria == cat);
                                if (cantidad > 0 || filtroCategoriaDoc == cat)
                                {
                                    <button type="button" class="btn btn-sm @(filtroCategoriaDoc == cat ? "btn-primary" : "btn-light border")" 
                                            @onclick="@(() => FiltrarPorCategoria(cat))">
                                        @cat (@cantidad)
                                    </button>
                                }
                            }
                        </div>

                        <!-- LISTA / TABLA DE DOCUMENTOS -->
                        @if (!documentosFiltrados.Any())
                        {
                            <div class="text-center p-5 border rounded bg-light text-muted">
                                <RadzenIcon Icon="folder_open" Style="font-size: 3rem;" Class="text-secondary" />
                                <h6 class="mt-2 text-dark">No hay documentos en esta categoría</h6>
                                <p class="small m-0">Utiliza el botón de subida superior para adjuntar archivos oficiales al expediente.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive w-100">
                                <RadzenDataGrid Data="@documentosFiltrados" TItem="DocumentoExpediente" AllowSorting="true" AllowPaging="true" PageSize="8" Class="w-100">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Title="Documento / Tipo" Width="280px">
                                            <Template Context="d">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="flex-shrink-0">
                                                        <RadzenIcon Icon="@ObtenerIconoFormato(d.Extension)" Class="@ObtenerClaseColorFormato(d.Extension)" Style="font-size: 1.8rem;" />
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block">@d.TipoDocumento</strong>
                                                        <span class="text-muted small font-monospace d-block text-truncate" style="max-width: 200px;" title="@d.NombreOriginal">
                                                            @d.NombreOriginal
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(d.Observaciones))
                                                        {
                                                            <small class="text-secondary fst-italic">@d.Observaciones</small>
                                                        }
                                                    </div>
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Property="Categoria" Title="Categoría" Width="140px">
                                            <Template Context="d">
                                                <span class="badge bg-secondary-subtle text-secondary border">@d.Categoria</span>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Title="Tamaño / Fecha" Width="140px">
                                            <Template Context="d">
                                                <div>
                                                    <span class="badge bg-light text-dark border">@FormatTamano(d.TamanoBytes)</span>
                                                    <small class="text-muted d-block mt-1">@d.FechaSubida.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Title="Custodia Física" Width="200px">
                                            <Template Context="d">
                                                @if (d.CustodiaFisicaVerificada)
                                                {
                                                    <div class="small">
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success d-inline-flex align-items-center gap-1">
                                                            <RadzenIcon Icon="inventory" Style="font-size: 0.8rem;" /> Original en Carpeta
                                                        </span>
                                                        <div class="text-muted mt-1 font-monospace" style="font-size: 0.72rem;">@(d.UbicacionFisica ?? "Archivo Central")</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">
                                                        ⚪ Solo Copia Digital
                                                    </span>
                                                }
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Title="Destino" Width="100px" TextAlign="TextAlign.Center">
                                            <Template Context="d">
                                                <span class="badge @(d.ProveedorAlmacenamiento == "SYNOLOGY" ? "bg-info text-dark" : "bg-light text-dark border")" style="font-size: 0.7rem;">
                                                    @(d.ProveedorAlmacenamiento == "SYNOLOGY" ? "NAS" : "LOCAL")
                                                </span>
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn TItem="DocumentoExpediente" Title="Acciones" Width="140px" TextAlign="TextAlign.Center">
                                            <Template Context="d">
                                                <div class="d-flex justify-content-center gap-1">
                                                    <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" 
                                                                  Click="@(() => AbrirVisorDocumento(d))" title="Visualizar documento" />
                                                    <a href="@d.RutaAlmacenamiento" target="_blank" download="@d.NombreOriginal" 
                                                       class="rz-button rz-button-xs rz-variant-flat rz-light text-decoration-none d-inline-flex align-items-center" title="Descargar original">
                                                        <RadzenIcon Icon="download" Style="font-size: 0.85rem;" />
                                                    </a>
                                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" 
                                                                  Click="@(() => ConfirmarEliminarDocumento(d))" title="Eliminar documento" />
                                                </div>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </div>
                        }
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

        <!-- MODAL DE VISUALIZACIÓN DE DOCUMENTOS (PDF & IMÁGENES) -->
        @if (mostrandoModalVisor && documentoSeleccionadoVisor != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-height: 95vh;">
                    <div class="modal-content shadow-lg border-0">
                        <div class="modal-header bg-dark text-white d-flex align-items-center justify-content-between p-2 px-3">
                            <div class="d-flex align-items-center gap-2">
                                <RadzenIcon Icon="@ObtenerIconoFormato(documentoSeleccionadoVisor.Extension)" Class="text-white fs-5" />
                                <div>
                                    <strong class="modal-title fs-6">@documentoSeleccionadoVisor.TipoDocumento</strong>
                                    <small class="text-white-50 d-block" style="font-size: 0.72rem;">@documentoSeleccionadoVisor.NombreOriginal • @FormatTamano(documentoSeleccionadoVisor.TamanoBytes)</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="@documentoSeleccionadoVisor.RutaAlmacenamiento" target="_blank" download="@documentoSeleccionadoVisor.NombreOriginal" 
                                   class="btn btn-sm btn-outline-light d-flex align-items-center gap-1">
                                    <RadzenIcon Icon="download" Style="font-size: 0.9rem;" />
                                    <span>Descargar</span>
                                </a>
                                <button type="button" class="btn-close btn-close-white" @onclick="@(() => mostrandoModalVisor = false)"></button>
                            </div>
                        </div>
                        <div class="modal-body p-0 bg-secondary bg-opacity-10 d-flex justify-content-center align-items-center" style="min-height: 500px;">
                            @if (documentoSeleccionadoVisor.Extension == ".pdf")
                            {
                                <iframe src="@documentoSeleccionadoVisor.RutaAlmacenamiento" style="width: 100%; height: 78vh; border: none;"></iframe>
                            }
                            else if (documentoSeleccionadoVisor.Extension == ".jpg" || documentoSeleccionadoVisor.Extension == ".jpeg" || documentoSeleccionadoVisor.Extension == ".png" || documentoSeleccionadoVisor.Extension == ".webp")
                            {
                                <div class="p-3 text-center w-100">
                                    <img src="@documentoSeleccionadoVisor.RutaAlmacenamiento" alt="@documentoSeleccionadoVisor.NombreOriginal" 
                                         class="img-fluid rounded shadow-sm border bg-white" style="max-height: 75vh; object-fit: contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="p-5 text-center bg-white rounded shadow-sm">
                                    <RadzenIcon Icon="description" Class="text-primary fs-1 mb-2" />
                                    <h5 class="fw-bold">Vista previa no disponible para este tipo de archivo</h5>
                                    <p class="text-muted">El archivo @documentoSeleccionadoVisor.Extension puede descargarse directamente.</p>
                                    <a href="@documentoSeleccionadoVisor.RutaAlmacenamiento" target="_blank" download="@documentoSeleccionadoVisor.NombreOriginal" class="btn btn-primary">
                                        Descargar Archivo
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="modal-footer bg-light p-2 justify-content-between">
                            <span class="small text-muted">
                                Subido por <b>@documentoSeleccionadoVisor.SubidoPor</b> el @documentoSeleccionadoVisor.FechaSubida.ToString("dd/MM/yyyy HH:mm") 
                                (Almacenado en: <b>@documentoSeleccionadoVisor.ProveedorAlmacenamiento</b>)
                            </span>
                            <RadzenButton Text="Cerrar" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => mostrandoModalVisor = false)" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Expediente? expediente;
    private bool cargando = true;

    // Catálogos desde Base de Datos (Zero Hardcoded Lists)
    private List<Cliente> clientes = new();
    private List<TipoSigno> tiposSigno = new();
    private List<EstadoProcesal> estadosProcesales = new();
    private List<TipoActuacion> tiposActuaciones = new();
    private List<ViaPresentacion> viasPresentacion = new();
    private List<UbicacionArchivo> ubicacionesArchivo = new();
    private List<ClaseNizaItem> catalogoNiza = ClaseNizaItem.ObtenerCatalogoCompleto();
    private List<Litigio> litigiosExpediente = new();

    // Formularios y modelos locales
    private int tabPrincipalIndex = 0;
    private ActuacionExpediente nuevaActuacion = new();
    private int? nuevoEstadoParaActuacion;
    private PublicacionENAG publicacionActual = new();
    private CertificadoRegistro certificadoActual = new();

    // Control Financiero y Solvencia P360
    private List<FacturaCobro> facturasExpediente = new();
    private decimal saldoPendienteExpediente = 0m;
    private bool esSolventeP360 = false;

    // Motor de Plazos Legales y Semáforo (Art. 42 LPA)
    private List<PlazoLegal> plazosExpediente = new();
    private (PlazoLegal? Plazo, SemaforoPlazo? Semaforo) plazoMasUrgente;
    private Dictionary<Guid, SemaforoPlazo> semaforosPlazos = new();

    // Formulario de nuevo plazo procesal
    private bool mostrandoFormNuevoPlazo = false;
    private string presetPlazoSeleccionado = "prevencion-forma";
    private string conceptoPlazoNuevo = "Auto de Prevención de Forma (Subsanar Requisitos)";
    private int diasHabilesNuevo = 30;
    private DateTime fechaNotificacionNuevo = DateTime.Today;
    private DateTime fechaFatalProyectada = DateTime.Today;

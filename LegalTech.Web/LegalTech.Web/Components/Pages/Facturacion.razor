        {
            expedienteFiltro = await ExpedienteService.GetExpedienteDetalleAsync(ExpedienteId.Value);
        }

        tasaISVActual = await FacturacionService.GetParametroDecimalAsync("ISV_PORCENTAJE", 15.00m) / 100m;
        rtnEmisor = await FacturacionService.GetParametroStringAsync("RTN_EMISOR", "08011990123456");
        nombreEmisor = await FacturacionService.GetParametroStringAsync("NOMBRE_EMISOR", "LegalTech Honduras S. de R.L.");
        direccionEmisor = await FacturacionService.GetParametroStringAsync("DIRECCION_EMISOR", "Edificio Corporativo Centro Morazán, Torre 1, Piso 7, Boulevard Morazán, Tegucigalpa, M.D.C., Francisco Morazán, Honduras");
        telefonoEmisor = await FacturacionService.GetParametroStringAsync("TELEFONO_EMISOR", "+504 2239-0000 / +504 9988-7766");
        correoEmisor = await FacturacionService.GetParametroStringAsync("CORREO_EMISOR", "facturacion@legaltech.hn");
        caiAutorizado = await FacturacionService.GetParametroStringAsync("CAI_SAR_AUTORIZADO", "A84F2B-98CE21-1B4480-1498B2-FA8321-44");
        rangoAutorizado = await FacturacionService.GetParametroStringAsync("RANGO_AUTORIZADO_SAR", "001-001-01-00000001 al 001-001-01-00050000");
        fechaLimiteEmision = await FacturacionService.GetParametroStringAsync("FECHA_LIMITE_SAR", "31/12/2027");

        CalcularKPIs();
        FiltrarFacturas();
        cargando = false;

        if (Nueva == true && !mostrarModalNuevaFactura)
        {
            await AbrirModalNuevaFactura();
            if (expedienteFiltro != null)
            {
                nuevaFactura.ExpedienteId = expedienteFiltro.Id;
                nuevaFactura.ClienteId = expedienteFiltro.ClienteId;
            }
        }
    }

    private void CalcularKPIs()
    {
        totalFacturadoHNL = 0m;
        totalCobradoHNL = 0m;
        totalSaldoPendienteHNL = 0m;
        totalFacturasConSaldo = 0;
        totalProformasHNL = 0m;
        totalProformasCount = 0;

        foreach (var f in facturas.Where(f => f.Estado != EstadoFactura.Anulada))
        {
            decimal factor = f.Moneda == "USD" ? f.TasaCambio : 1m;
            if (f.EsProforma)
            {
                totalProformasHNL += f.TotalFactura * factor;
                totalProformasCount++;
            }
            else
            {
                totalFacturadoHNL += f.TotalFactura * factor;
                totalCobradoHNL += f.MontoPagado * factor;
                totalSaldoPendienteHNL += f.SaldoPendiente * factor;

                if (f.SaldoPendiente > 0)
                {
                    totalFacturasConSaldo++;
                }
            }
        }

        // Conteo de expedientes solventes: Solo deudas oficiales activas bloquean P360
        var expedientesIds = facturas.Where(f => f.ExpedienteId.HasValue).Select(f => f.ExpedienteId!.Value).Distinct();
        expedientesSolventes = 0;
        foreach (var expId in expedientesIds)
        {
            var facs = facturas.Where(f => f.ExpedienteId == expId && !f.EsProforma && f.Estado != EstadoFactura.Anulada);
            if (facs.Any() && facs.All(f => f.SaldoPendiente == 0))
            {
                expedientesSolventes++;
            }
            else if (!facs.Any())
            {
                expedientesSolventes++;
            }
        }
    }

    private void FiltrarFacturas()
    {
        var query = facturas.AsEnumerable();

        if (ExpedienteId.HasValue)
        {
            query = query.Where(f => f.ExpedienteId == ExpedienteId.Value);
        }

        if (filtroEstado > 0)
        {
            query = query.Where(f => (int)f.Estado == filtroEstado);
        }

        if (filtroMoneda != "Todas")
        {
            query = query.Where(f => f.Moneda == filtroMoneda);
        }

        if (filtroHito != "Todos")
        {
            query = query.Where(f => f.HitoProcesal == filtroHito);
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            string t = textoBusqueda.Trim().ToLowerInvariant();
            query = query.Where(f =>
                f.NumeroFactura.ToLowerInvariant().Contains(t) ||
                (f.NumeroCAI != null && f.NumeroCAI.ToLowerInvariant().Contains(t)) ||
                f.Cliente.NombreRazonSocial.ToLowerInvariant().Contains(t) ||
                f.Cliente.NumeroIdentificacionRTN.ToLowerInvariant().Contains(t) ||
                (f.Expediente != null && f.Expediente.CodigoInterno.ToLowerInvariant().Contains(t)) ||
                (f.Expediente != null && f.Expediente.DenominacionMarca.ToLowerInvariant().Contains(t))
            );
        }

        facturasFiltradas = query.ToList();
    }


    private async Task AbrirModalNuevaFactura()
    {
        tipoEmisionSeleccionada = EstadoFactura.Borrador;
        string prefijo = $"PROF-2026-{(facturas.Count(f => f.EsProforma) + 1):D4}";
        decimal tasaCambio = await FacturacionService.GetParametroDecimalAsync("TASA_CAMBIO_USD_HNL", 25.50m);

        nuevaFactura = new FacturaCobro
        {
            Id = Guid.Empty,
            NumeroFactura = prefijo,
            NumeroCAI = null,
            ClienteId = expedienteFiltro?.ClienteId ?? clientes.FirstOrDefault()?.Id ?? Guid.Empty,
            ExpedienteId = expedienteFiltro?.Id,
            FechaEmision = DateTime.Today,
            FechaVencimiento = DateTime.Today.AddDays(15),
            Moneda = "HNL",
            TasaCambio = tasaCambio,
            HitoProcesal = "Presentación Oficial",
            Estado = EstadoFactura.Borrador,
            SolicitadoPor = "Abg. Especialista",
            CreadoEn = DateTime.UtcNow,
            Detalles = new List<DetalleFacturaCobro>()
        };

        // Cargar por defecto la tarifa de presentación si existe
        var tarifaPresentacion = tarifasDisponibles.FirstOrDefault(t => t.EtapaProcesal == "Presentación");
        if (tarifaPresentacion != null)
        {
            tarifaSeleccionadaId = tarifaPresentacion.Id;
            AgregarTarifaAFactura();
        }

        mostrarModalNuevaFactura = true;
    }

    private void AlSeleccionarExpedienteEnFactura()
    {
        if (nuevaFactura.ExpedienteId.HasValue)
        {
            var exp = expedientes.FirstOrDefault(e => e.Id == nuevaFactura.ExpedienteId.Value);
            if (exp != null)
            {
                nuevaFactura.ClienteId = exp.ClienteId;
            }
        }
    }

    private void AgregarTarifaAFactura()
    {
        if (!tarifaSeleccionadaId.HasValue) return;
        var t = tarifasDisponibles.FirstOrDefault(x => x.Id == tarifaSeleccionadaId.Value);
        if (t == null) return;

        bool esUSD = nuevaFactura.Moneda == "USD";
        decimal honorarios = esUSD ? t.HonorariosUSD : t.HonorariosHNL;
        decimal gastos = esUSD ? t.GastosOficialesUSD : t.GastosOficialesHNL;

        // Línea de honorarios profesionales (gravado)
        if (honorarios > 0)
        {
            nuevaFactura.Detalles.Add(new DetalleFacturaCobro
            {
                Id = Guid.NewGuid(),
                TarifaArancelariaId = t.Id,
                Concepto = $"Honorarios: {t.Concepto}",
                EsGastoOficial = false,
                Cantidad = 1,
                PrecioUnitario = honorarios,
                Subtotal = honorarios,
                MontoISV = Math.Round(honorarios * tasaISVActual, 2),
                TotalLinea = honorarios + Math.Round(honorarios * tasaISVActual, 2)
            });
        }

        // Línea de gastos oficiales exentos
        if (gastos > 0)
        {
            nuevaFactura.Detalles.Add(new DetalleFacturaCobro
            {
                Id = Guid.NewGuid(),
                TarifaArancelariaId = t.Id,
                Concepto = $"Gastos Oficiales: Tasas gubernamentales / ENAG ({t.Concepto})",
                EsGastoOficial = true,
                Cantidad = 1,
                PrecioUnitario = gastos,
                Subtotal = gastos,
                MontoISV = 0m,
                TotalLinea = gastos
            });
        }

        RecalcularTotalesNuevaFactura();
    }

    private void EliminarLineaFactura(DetalleFacturaCobro linea)
    {
        nuevaFactura.Detalles.Remove(linea);
        RecalcularTotalesNuevaFactura();
    }

    private void RecalcularTotalesNuevaFactura()
    {
        decimal hon = 0m;
        decimal gas = 0m;
        decimal isv = 0m;

        foreach (var d in nuevaFactura.Detalles)
        {
            d.Subtotal = d.Cantidad * d.PrecioUnitario;
            if (d.EsGastoOficial)
            {
                d.MontoISV = 0m;
                gas += d.Subtotal;
            }
            else
            {
                d.MontoISV = Math.Round(d.Subtotal * tasaISVActual, 2);
                hon += d.Subtotal;
                isv += d.MontoISV;
            }
            d.TotalLinea = d.Subtotal + d.MontoISV;
        }

        nuevaFactura.SubtotalHonorarios = hon;
        nuevaFactura.SubtotalGastosOficiales = gas;
        nuevaFactura.MontoISV = isv;
        nuevaFactura.TotalFactura = hon + gas + isv;
        nuevaFactura.SaldoPendiente = nuevaFactura.TotalFactura - nuevaFactura.MontoPagado;
    }

    private async Task GuardarFacturaConEstado(EstadoFactura estadoDestino)
    {
        if (nuevaFactura.ClienteId == Guid.Empty)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "Debe seleccionar un cliente.");
            return;
        }

        if (!nuevaFactura.Detalles.Any())
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Atención", "Debe agregar al menos una línea o servicio a la factura.");
            return;
        }

        nuevaFactura.Estado = estadoDestino;
        if (estadoDestino == EstadoFactura.Emitida)
        {
            if (string.IsNullOrEmpty(nuevaFactura.NumeroFactura) || nuevaFactura.NumeroFactura.StartsWith("PROF-"))
            {
                nuevaFactura.NumeroFactura = $"FAC-2026-{(facturas.Count(f => !f.EsProforma) + 1):D4}";
            }
            if (string.IsNullOrEmpty(nuevaFactura.NumeroCAI))
            {
                nuevaFactura.NumeroCAI = await FacturacionService.GetParametroStringAsync("CAI_SAR_AUTORIZADO", "A84F2B-98CE21-1B4480-1498B2-FA8321-44");
            }
            nuevaFactura.AprobadoPor = "Socio Director";
            nuevaFactura.FechaAprobacion = DateTime.UtcNow;
        }
        else
        {
            nuevaFactura.SolicitadoPor = "Abg. Especialista";
            if (string.IsNullOrEmpty(nuevaFactura.NumeroFactura) || nuevaFactura.NumeroFactura.StartsWith("FAC-"))
            {
                nuevaFactura.NumeroFactura = $"PROF-2026-{(facturas.Count(f => f.EsProforma) + 1):D4}";
            }
            nuevaFactura.NumeroCAI = null;
        }

        await FacturacionService.GuardarFacturaAsync(nuevaFactura, "Abg. Administrador");
        
        string msg = estadoDestino switch
        {
            EstadoFactura.Borrador => $"Proforma {nuevaFactura.NumeroFactura} guardada en borrador.",
            EstadoFactura.PendienteAprobacion => $"Proforma {nuevaFactura.NumeroFactura} enviada a revisión de socios.",
            EstadoFactura.Emitida => $"Factura oficial SAR {nuevaFactura.NumeroFactura} emitida exitosamente.",
            _ => $"Documento {nuevaFactura.NumeroFactura} guardado."
        };

        NotificationService.Notify(NotificationSeverity.Success, "Operación Exitosa", msg);
        mostrarModalNuevaFactura = false;
        await CargarDatos();
    }


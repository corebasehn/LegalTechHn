@page "/acceso-denegado"
@using LegalTech.Web.Domain.Entities
@inject NavigationManager NavigationManager

<PageTitle>Acceso Denegado - LegalTech Honduras</PageTitle>

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">
                <div class="mb-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-2">
                        <RadzenIcon Icon="gpp_bad" Style="font-size: 4rem;" />
                    </div>
                </div>

                <h3 class="fw-bold text-dark mb-2">Acceso Restringido (403)</h3>
                <p class="text-muted mb-4">
                    Su perfil actual de usuario no cuenta con los privilegios suficientes para acceder a este módulo confidencial. 
                    Esta acción ha sido registrada en la bitácora de auditoría del despacho.
                </p>

                <div class="p-3 bg-light rounded-3 text-start small mb-4 border">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <RadzenIcon Icon="info" Class="text-primary" />
                        <strong>Política de Confidencialidad y Secreto Profesional:</strong>
                    </div>
                    <span class="text-secondary">
                        Si considera que requiere acceso a esta sección o expediente para cumplir con una diligencia legal, 
                        solicite la asignación del rol correspondiente al <b>Socio Director</b>.
                    </span>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <RadzenButton Icon="home" Text="Ir al Inicio" ButtonStyle="ButtonStyle.Primary" 
                                  Click="@(() => NavigationManager.NavigateTo("/"))" />
                    <RadzenButton Icon="folder_special" Text="Ver Expedientes" ButtonStyle="ButtonStyle.Light" 
                                  Click="@(() => NavigationManager.NavigateTo("/expedientes"))" />
                </div>
            </div>
        </div>
    </div>
</div>

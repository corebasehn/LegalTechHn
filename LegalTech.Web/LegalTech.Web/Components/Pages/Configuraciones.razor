                                <Template Context="t">
                                    <strong>@t.Concepto</strong>
                                    <div class="small text-muted">@t.Descripcion</div>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Property="EtapaProcesal" Title="Etapa" Width="130px">
                                <Template Context="t">
                                    <span class="badge bg-light text-dark border">@t.EtapaProcesal</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Title="Honorarios" Width="160px" TextAlign="TextAlign.Right">
                                <Template Context="t">
                                    <div><strong>L @t.HonorariosHNL.ToString("N2")</strong></div>
                                    <small class="text-muted">$ @t.HonorariosUSD.ToString("N2")</small>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Title="Gastos Oficiales" Width="160px" TextAlign="TextAlign.Right">
                                <Template Context="t">
                                    <div><strong class="text-secondary">L @t.GastosOficialesHNL.ToString("N2")</strong></div>
                                    <small class="text-muted">$ @t.GastosOficialesUSD.ToString("N2")</small>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Property="AplicaISV" Title="ISV 15%" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="t">
                                    <span class="badge @(t.AplicaISV ? "bg-info" : "bg-light text-muted border")">
                                        @(t.AplicaISV ? "ISV" : "Exento")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Property="Activo" Title="Estado" Width="100px" TextAlign="TextAlign.Center">
                                <Template Context="t">
                                    <span class="badge @(t.Activo ? "bg-success" : "bg-secondary")">
                                        @(t.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TarifaArancelaria" Title="Acciones" Width="120px" TextAlign="TextAlign.Center">
                                <Template Context="t">
                                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Click="@(() => EditarTarifa(t))" Class="me-1" title="Editar" />
                                    <RadzenButton Icon="@(t.Activo ? "toggle_on" : "toggle_off")" 
                                                  ButtonStyle="@(t.Activo ? ButtonStyle.Warning : ButtonStyle.Light)" 
                                                  Size="ButtonSize.ExtraSmall" Click="@(() => ToggleTarifa(t.Id))" 
                                                  title="@(t.Activo ? "Desactivar" : "Activar")" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </RadzenCard>
        }
    }
</div>

